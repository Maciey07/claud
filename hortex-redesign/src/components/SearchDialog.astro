---
import Icon from './Icon.astro';
---
<dialog class="search" data-search aria-labelledby="search-title">
  <div class="search__panel">
    <div class="search__head">
      <h2 id="search-title" class="visually-hidden">Szukaj w serwisie</h2>
      <Icon name="search" class="search__icon" />
      <label for="search-input" class="visually-hidden">Czego szukasz?</label>
      <input id="search-input" class="search__input" type="search" placeholder="Szukaj produktu, przepisu, porady…" autocomplete="off" data-search-input />
      <button class="search__close" type="button" data-search-close aria-label="Zamknij wyszukiwarkę"><Icon name="close" /></button>
    </div>
    <div class="search__tabs" role="tablist" aria-label="Zakres wyszukiwania">
      <button role="tab" type="button" class="chip" aria-selected="true" aria-pressed="true" data-scope="produkty">Produkty <span data-count="produkty"></span></button>
      <button role="tab" type="button" class="chip" aria-selected="false" aria-pressed="false" data-scope="przepisy">Przepisy <span data-count="przepisy"></span></button>
      <button role="tab" type="button" class="chip" aria-selected="false" aria-pressed="false" data-scope="porady">Porady <span data-count="porady"></span></button>
    </div>
    <ul class="search__results" role="list" data-search-results aria-live="polite"></ul>
    <p class="search__hint t-small t-muted">Podpowiedź: wpisz składnik, np. „brokuł” albo „kurki”.</p>
  </div>
</dialog>

<style>
  .search { border: 0; padding: 0; background: transparent; width: min(760px, calc(100vw - 32px)); max-height: min(80vh, 720px); margin: 10vh auto auto; }
  .search::backdrop { background: rgb(28 35 29 / 0.55); backdrop-filter: blur(4px); }
  .search__panel { background: var(--c-bg); border-radius: 12px; padding: var(--s-3); display: grid; gap: var(--s-2); max-height: inherit; grid-template-rows: auto auto 1fr auto; }
  .search__head { display: flex; align-items: center; gap: var(--s-2); border-bottom: 1.5px solid var(--c-ink); padding-bottom: var(--s-2); }
  .search__head :global(.search__icon) { width: 26px; height: 26px; }
  .search__input { flex: 1; border: 0; background: none; font-size: 1.375rem; font-family: var(--font-display); font-weight: 600; min-width: 0; padding: 4px 0; }
  .search__input:focus-visible { outline: none; }
  .search__close { border: 0; background: none; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; }
  .search__close:hover { background: var(--c-sunk); }
  .search__close :global(svg) { width: 22px; height: 22px; }
  .search__tabs { display: flex; gap: var(--s-1); flex-wrap: wrap; }
  .search__tabs span { opacity: 0.7; font-variant-numeric: tabular-nums; }
  .search__results { list-style: none; padding: 0; overflow-y: auto; display: grid; gap: 2px; align-content: start; min-height: 120px; }
  .search__results :global(a) { display: grid; grid-template-columns: 56px 1fr auto; gap: var(--s-2); align-items: center; padding: 8px; border-radius: var(--r-ui); text-decoration: none; }
  .search__results :global(a:hover), .search__results :global(a:focus-visible) { background: var(--c-sunk); }
  .search__results :global(img) { width: 56px; height: 56px; object-fit: contain; background: var(--c-sunk); border-radius: var(--r-img); }
  .search__results :global(mark) { background: var(--c-brand-soft); color: inherit; border-radius: 2px; }
  .search__results :global(.m) { color: var(--c-ink-muted); font-size: var(--fs-small); }
  .search__results :global(.empty) { padding: var(--s-4) 0; color: var(--c-ink-muted); }
</style>

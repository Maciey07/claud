---
/** Breadcrumbs + JSON-LD BreadcrumbList */
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
const all = [{ label: 'Strona główna', href: '/' }, ...items];
const site = Astro.site!;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((it, i) => ({ '@type': 'ListItem', position: i + 1, name: it.label, ...(it.href ? { item: new URL(it.href, site).href } : {}) })),
};
---
<nav class="breadcrumbs" aria-label="Okruszki">
  <ol>
    {all.map((it, i) => (
      <li>{it.href && i < all.length - 1 ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}</li>
    ))}
  </ol>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</nav>

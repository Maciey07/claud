---
import Base from '../../layouts/Base.astro';
import RecipeListing from '../../components/RecipeListing.astro';
import { site } from '../../lib/data';

export function getStaticPaths() {
  return site.recipeCategories.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: { slug: string; name: string } };
---
<Base title={`${c.name}: przepisy`} description={`${c.name}: przepisy z produktami Hortex.`} current="przepisy">
  <RecipeListing title={c.name} lead={`Przepisy z kategorii ${c.name.toLowerCase()}, z produktami Hortex.`} activeCategory={c.slug} crumbs={[{ label: 'Przepisy', href: '/przepisy/' }, { label: c.name }]} />
</Base>

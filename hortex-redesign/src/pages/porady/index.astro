---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site, t } from '../../lib/data';
import { img } from '../../lib/images';
---
<Base title="Porady" description="Porady Hortex: przechowywanie mrożonek, gotowanie warzyw, wartości odżywcze." current="porady">
  <section class="container list-page">
    <Breadcrumbs items={[{ label: 'Porady' }]} />
    <h1>Porady</h1>
    <p class="t-lead t-muted">Jak przechowywać, gotować i planować posiłki z mrożonek.</p>
    <ul class="advice" role="list">
      {site.advice.map((a) => (
        <li class="card advice__item">
          <div class="advice__art" aria-hidden="true">{a.pieces.map((k) => <img src={img.ing(k)} alt="" width="200" height="200" loading="lazy" />)}</div>
          <div>
            <h2 class="card__title t-h3"><a href={`/porady/${a.slug}/`}>{t(a.title)}</a></h2>
            <p class="t-muted">{t(a.excerpt)}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>
<style>
  .list-page { padding-block: var(--s-4) var(--s-section); display: grid; gap: var(--s-3); }
  .list-page h1 { margin-top: var(--s-2); }
  .advice { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--grid-gap); margin-top: var(--s-4); }
  .advice__art { aspect-ratio: 4/3; background: var(--c-sunk); border-radius: var(--r-img); display: flex; align-items: center; justify-content: center; }
  .advice__art img { width: 38%; transition: transform var(--t-reveal) var(--ease-hortex); }
  .advice__item:hover .advice__art img:first-child { transform: rotate(-12deg) translateY(-6px); }
  .advice__item:hover .advice__art img:last-child { transform: rotate(10deg) translateY(4px); }
  .advice__item p { margin-top: var(--s-1); }
  @media (max-width: 900px) { .advice { grid-template-columns: 1fr; } }
</style>

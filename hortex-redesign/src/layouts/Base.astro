---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';

interface Props {
  title: string;
  description?: string;
  audience?: 'dom' | 'biznes';
  current?: string;
  jsonLd?: object | object[];
  tint?: string;
  preloadImage?: string;
}
const { title, description = 'Mrożone warzywa, owoce, frytki i dania gotowe Hortex. Przepisy, produkty i oferta dla gastronomii.', audience = 'dom', current, jsonLd, tint, preloadImage } = Astro.props;
const fullTitle = title === 'Hortex' ? 'Hortex: prosto z natury' : `${title} | Hortex`;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Prototyp koncepcyjny: nie indeksujemy -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#123f22" />
    <link rel="preload" href="/fonts/bricolage-latin.woff2" as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />}
    <script is:inline>
      // Klasa motion-ok tylko gdy JS działa i użytkownik nie wyłączył animacji.
      if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) document.documentElement.classList.add('motion-ok');
    </script>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body style={tint ? `--section-tint: ${tint}` : undefined}>
    <a class="skip-link" href="#main">Przejdź do treści</a>
    <Header audience={audience} current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SearchDialog />
    <script>
      import '../scripts/site';
      import '../scripts/motion/index';
    </script>
  </body>
</html>

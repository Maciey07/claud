---
import type { ProductArt as Art } from '../lib/types';

/**
 * Ilustracja produktu w kolorach marki. Placeholder do czasu zdjęć produktowych [DO UZUPEŁNIENIA].
 * view: 'front' (produkt na kolorze) albo 'pattern' (produkt na wzorze rombów).
 */
interface Props { art: Art; label: string; view?: 'front' | 'pattern'; class?: string }
const { art, label, view = 'front', class: cls } = Astro.props;
const c = (n: string) => `var(--ofca-${n})`;
const bg = c(art.bg);
const fg = c(art.fg);
const ink = c('ink');
const cream = c('cream');
const uid = `pa-${Math.random().toString(36).slice(2, 8)}`;
const toteScale = art.size === 'l' ? 1 : art.size === 'm' ? 0.88 : 0.76;
---
<svg class:list={['product-art', cls]} viewBox="0 0 400 440" role={label ? 'img' : undefined} aria-label={label || undefined} aria-hidden={label ? undefined : 'true'} focusable="false">
  <defs>
    <pattern id={`${uid}-dia`} width="40" height="80" patternUnits="userSpaceOnUse">
      <rect width="40" height="80" fill={view === 'pattern' ? cream : bg} />
      <path d="M20 0l20 40-20 40L0 40z" fill={view === 'pattern' ? c('lilac') : bg} opacity={view === 'pattern' ? 1 : 0} />
    </pattern>
    <pattern id={`${uid}-dia-small`} width="16" height="32" patternUnits="userSpaceOnUse">
      <path d="M8 0l8 16-8 16L0 16z" fill={fg} />
    </pattern>
    <pattern id={`${uid}-check`} width="20" height="20" patternUnits="userSpaceOnUse">
      <rect width="20" height="20" fill={cream} /><rect width="10" height="10" fill={ink} /><rect x="10" y="10" width="10" height="10" fill={ink} />
    </pattern>
  </defs>
  <rect width="400" height="440" fill={view === 'pattern' ? `url(#${uid}-dia)` : bg} />

  {art.kind === 'tee' && (
    <g>
      <path d="M140 70 L 110 80 L 40 130 L 75 190 L 115 170 L 115 390 L 285 390 L 285 170 L 325 190 L 360 130 L 290 80 L 260 70 C 250 95, 150 95, 140 70 Z"
        fill={art.bg === 'ink' ? cream : art.bg === 'orange' ? ink : cream} />
      <path d="M140 70 C 150 95, 250 95, 260 70" fill="none" stroke={art.bg === 'orange' ? cream : ink} stroke-width="5" />
      {art.print === 'highline' ? (
        <g>
          <line x1="140" y1="210" x2="260" y2="210" stroke={ink} stroke-width="4" />
          <circle cx="200" cy="170" r="7" fill={ink} />
          <path d="M200 177v22M184 186l16 4 16-4M200 199l-7 11M200 199l7 11" stroke={ink} stroke-width="5" fill="none" stroke-linecap="round" />
          <text x="200" y="262" text-anchor="middle" font-family="Anybody Variable, sans-serif" font-weight="900" font-size="28" fill={ink} textLength="150" lengthAdjust="spacingAndGlyphs">HIGHLINE</text>
        </g>
      ) : (
        <g>
          <rect x="150" y="140" width="100" height="90" fill={`url(#${uid}-dia-small)`} />
          <text x="200" y="272" text-anchor="middle" font-family="Anybody Variable, sans-serif" font-weight="900" font-size="40" fill={art.bg === 'orange' ? cream : ink} style="font-stretch: 150%">OFCA</text>
          {art.print === 'ofca-2026' && <text x="200" y="300" text-anchor="middle" font-family="Anybody Variable, sans-serif" font-weight="800" font-size="18" fill={art.bg === 'orange' ? cream : ink}>2026</text>}
        </g>
      )}
    </g>
  )}

  {art.kind === 'mug' && (
    <g>
      <path d="M270 170 h28 a42 42 0 0 1 0 84 h-28" fill="none" stroke={fg} stroke-width="22" />
      <rect x="110" y="130" width="170" height="200" fill={fg} />
      <ellipse cx="195" cy="130" rx="85" ry="14" fill={ink} opacity="0.9" />
      <text x="195" y="245" text-anchor="middle" font-family="Anybody Variable, sans-serif" font-weight="900" font-size="36" fill={cream} style="font-stretch: 150%">OFCA</text>
      <rect x="110" y="290" width="170" height="20" fill={`url(#${uid}-check)`} />
    </g>
  )}

  {art.kind === 'magnet' && (
    <g transform="rotate(-6 200 220)">
      <rect x="95" y="120" width="210" height="210" fill={fg} />
      <path d="M200 150 L 270 290 L 130 290 Z" fill={cream} />
      <path d="M200 150 L 235 290 L 200 290 Z" fill={fg} opacity="0.5" />
      <path d={`M130 290 ${Array.from({ length: 7 }, (_, i) => `L ${130 + (i + 0.5) * 20} 305 L ${130 + (i + 1) * 20} 290`).join(' ')}`} fill={cream} />
    </g>
  )}

  {art.kind === 'lettering' && (
    <g>
      <text x="200" y="255" text-anchor="middle" font-family="Anybody Variable, sans-serif" font-weight="900" font-size="110" fill={fg} style="font-stretch: 150%" letter-spacing="-4">OFCA</text>
    </g>
  )}

  {(art.kind === 'pin-tent' || art.kind === 'pin-text') && (
    <g>
      <circle cx="200" cy="220" r="120" fill={ink} opacity="0.2" transform="translate(10 12)" />
      <circle cx="200" cy="220" r="120" fill={fg} />
      <circle cx="200" cy="220" r="104" fill="none" stroke={art.fg === 'ink' ? cream : ink} stroke-width="5" />
      {art.kind === 'pin-tent' ? (
        <g>
          <path d="M200 140 L 265 260 L 135 260 Z" fill={cream} />
          <path d="M200 140 L 225 260 L 175 260 Z" fill={fg} />
          <path d={`M135 260 ${Array.from({ length: 13 }, (_, i) => `L ${135 + (i + 0.5) * 10} 272 L ${135 + (i + 1) * 10} 260`).join(' ')}`} fill={cream} />
        </g>
      ) : (
        <text x="200" y="240" text-anchor="middle" font-family="Anybody Variable, sans-serif" font-weight="900" font-size="54" fill={ink} style="font-stretch: 150%">OFCA</text>
      )}
    </g>
  )}

  {art.kind === 'socks' && (
    <g>
      {[0, 1].map((i) => (
        <g transform={`translate(${i * 110 + 60} ${i * 20 + 40})`}>
          <path d="M40 0 h90 v220 l60 40 a40 40 0 0 1 -30 72 l-110 -48 a40 40 0 0 1 -10 -30 z" fill={fg} />
          <rect x="40" y="0" width="90" height="26" fill={ink} />
          {art.motif === 'diamonds' && Array.from({ length: 3 }, (_, k) => <path d={`M85 ${60 + k * 50}l18 22-18 22-18-22z`} fill={cream} />)}
          {art.motif === 'tents' && Array.from({ length: 3 }, (_, k) => <path d={`M85 ${55 + k * 55}l22 36h-44z`} fill={cream} />)}
        </g>
      ))}
    </g>
  )}

  {art.kind === 'tote' && (
    <g transform={`translate(200 250) scale(${toteScale}) translate(-200 -250)`}>
      <path d="M150 140 v-40 a50 50 0 0 1 100 0 v40" fill="none" stroke={fg} stroke-width="14" />
      <rect x="95" y="140" width="210" height="240" fill={fg} />
      <g>
        {Array.from({ length: 5 }, (_, i) => <path d={`M${125 + i * 38} 175l19 38-19 38-19-38z`} fill={art.fg === 'ink' ? c('lilac') : art.bg === 'orange' ? c('lilac') : c('orange')} />)}
      </g>
      <text x="200" y="335" text-anchor="middle" font-family="Anybody Variable, sans-serif" font-weight="900" font-size="52" fill={art.fg === 'ink' ? cream : ink} style="font-stretch: 150%">OFCA</text>
    </g>
  )}
</svg>
<style>
  .product-art { width: 100%; height: auto; display: block; }
</style>

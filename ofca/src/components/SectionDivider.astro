---
/** Separator sekcji: zygzak falbany, romby lub szachownica (ref-03). */
interface Props {
  variant?: 'zigzag' | 'diamonds' | 'checker';
  color?: 'orange' | 'lilac' | 'ink' | 'cream' | 'white';
  bg?: 'orange' | 'lilac' | 'ink' | 'cream' | 'white';
  flip?: boolean;
}
const { variant = 'zigzag', color = 'orange', bg = 'cream', flip = false } = Astro.props;
const c = (n: string) => `var(--ofca-${n})`;
---
{variant === 'zigzag' && (
  <div class:list={['zigzag', { 'zigzag-up': flip }]} style={`--zz-color:${c(color)}`} aria-hidden="true"></div>
)}
{variant === 'diamonds' && (
  <div class="diamonds diamond-strip" style={`--d-bg:${c(bg)};--d-fg:${c(color)}`} aria-hidden="true"></div>
)}
{variant === 'checker' && (
  <div class="checker checker-strip" style={`--c-a:${c(color)};--c-b:${c(bg)}`} aria-hidden="true"></div>
)}
<style>
  .zigzag { position: relative; z-index: 2; margin-bottom: calc(var(--zigzag) * -1); }
  .zigzag-up { margin-bottom: 0; margin-top: calc(var(--zigzag) * -1); }
</style>

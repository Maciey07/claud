---
/** Loader: 3 piłki na torze żonglerki (M5, MotionPathPlugin). */
interface Props { label: string; class?: string }
const { label, class: cls } = Astro.props;
---
<div class:list={['juggler', cls]} role="status" aria-live="polite" data-juggler>
  <svg viewBox="0 0 120 80" width="120" height="80" aria-hidden="true">
    <path data-juggle-path d="M60 40 C 60 8, 104 8, 104 40 C 104 72, 60 72, 60 40 C 60 8, 16 8, 16 40 C 16 72, 60 72, 60 40 Z" fill="none" stroke="none" />
    <circle data-ball r="7" cx="20" cy="70" fill="var(--ofca-orange)" />
    <circle data-ball r="7" cx="60" cy="40" fill="var(--ofca-lilac)" />
    <circle data-ball r="7" cx="100" cy="40" fill="var(--ofca-ink)" />
  </svg>
  <span class="visually-hidden">{label}</span>
</div>
<style>
  .juggler { display: inline-grid; place-items: center; }
</style>
<script>
  import { gsap, loadMotionPath, prefersReducedMotion } from '../lib/gsap';

  const els = document.querySelectorAll<HTMLElement>('[data-juggler]');
  if (els.length && !prefersReducedMotion()) {
    loadMotionPath().then(() => {
      els.forEach((el) => {
        const path = el.querySelector('[data-juggle-path]') as SVGPathElement;
        el.querySelectorAll('[data-ball]').forEach((ball, i) => {
          gsap.set(ball, { attr: { cx: 0, cy: 0 } });
          gsap.to(ball, {
            motionPath: { path, align: path, alignOrigin: [0.5, 0.5], start: i / 3, end: i / 3 + 1 },
            duration: 1.8, ease: 'none', repeat: -1,
          });
        });
      });
    });
  }
</script>

---
import Icon from './Icon.astro';
/** Lekki embed YouTube: iframe dopiero po kliknięciu (PRD 7.7). Bez videoId: placeholder. */
interface Props { videoId: string | null; title: string; lang: 'pl' | 'en' }
const { videoId, title, lang } = Astro.props;
---
<div class="lite-yt diamonds" style="--d-bg: var(--ofca-ink); --d-fg: var(--ofca-lilac); --d-w: 36px" data-lite-yt={videoId ?? undefined}>
  {videoId ? (
    <button type="button" class="play" data-lite-play>
      <svg viewBox="0 0 68 48" width="88" aria-hidden="true"><path d="M0 0h68v48H0z" fill="var(--ofca-orange)" /><path d="M27 14l18 10-18 10z" fill="var(--ofca-ink)" /></svg>
      <span class="label">{lang === 'pl' ? 'Odtwórz' : 'Play'}: {title}</span>
    </button>
  ) : (
    <div class="play">
      <Icon name="info" size={40} />
      <span class="label">{title}: [DO UZUPEŁNIENIA]</span>
    </div>
  )}
</div>
<style>
  .lite-yt { aspect-ratio: 16 / 9; display: grid; place-items: center; position: relative; }
  .play { display: grid; justify-items: center; gap: var(--space-3); background: var(--ofca-ink); color: var(--ofca-cream); border: 0; padding: var(--space-5); max-width: 90%; text-align: center; }
  button.play:hover svg path:first-child { fill: var(--ofca-cream); }
  .lite-yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-lite-yt]').forEach((el) => {
    el.querySelector('[data-lite-play]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.liteYt}?autoplay=1&cc_load_policy=1`;
      iframe.title = el.querySelector('.label')?.textContent ?? 'YouTube';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

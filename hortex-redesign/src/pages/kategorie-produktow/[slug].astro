---
import Base from '../../layouts/Base.astro';
import ProductListing from '../../components/ProductListing.astro';
import { categories, productsInCategory, type Category } from '../../lib/data';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Category };
const items = productsInCategory(c.slug);
const isHoreca = c.slug === 'horeca';
---
<Base title={c.name} description={c.description} current="produkty" audience={isHoreca ? 'biznes' : 'dom'}>
  <ProductListing
    title={isHoreca ? 'HoReCa: opakowania gastronomiczne' : c.name}
    lead={c.description}
    items={items}
    category={c}
    crumbs={[{ label: 'Produkty', href: '/produkty/' }, { label: c.name }]}
    showPackToggle={false}
  />
</Base>

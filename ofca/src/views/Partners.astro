---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { href } from '../i18n/routes';
import { site } from '../site.config';
import type { Lang } from '../lib/types';
interface Props { lang: Lang }
const { lang } = Astro.props;
const pl = lang === 'pl';
const T = '[DO UZUPEŁNIENIA]';
const c = pl ? {
  title: 'Partnerzy', h: 'Wesprzyj festiwal', desc: 'Partnerzy, grantodawcy i patroni Festiwalu OFCA oraz możliwości współpracy.',
  lead: 'Jedno z najważniejszych wydarzeń Nowego Cyrku w Polsce. Tysiące widzów, od 2014 roku.',
  cats: ['Organizator', 'Grantodawcy', 'Partnerzy', 'Patroni medialni'], logos: `Logotypy: ${T}`, note: 'Ekspozycja logotypów zgodnie z wymaganiami grantodawców (do sprawdzenia).',
  why: 'Dlaczego OFCA?', whyList: ['227 artystów z 22 krajów w dotychczasowych edycjach.', 'Ponad 150 osób w ekipie wolontariackiej.', 'Tysiące widzów na starym mieście w Oleśnicy.', 'Ślad w mieście: 6 murali i publiczne sprawozdania Fundacji.'],
  cta: 'Porozmawiajmy', subject: 'Współpraca z Festiwalem OFCA',
} : {
  title: 'Partners', h: 'Support the festival', desc: 'OFCA partners, funders and media patrons, and ways to work with us.',
  lead: 'One of the key contemporary circus events in Poland. Thousands of spectators, since 2014.',
  cats: ['Organiser', 'Funders', 'Partners', 'Media patrons'], logos: `Logos: ${T}`, note: 'Logo placement follows funder requirements (to be checked).',
  why: 'Why OFCA?', whyList: ['227 artists from 22 countries across past editions.', 'A volunteer crew of 150+.', 'Thousands of spectators in Oleśnica’s old town.', 'A mark on the town: 6 murals and public Foundation reports.'],
  cta: 'Let’s talk', subject: 'Partnering with OFCA',
};
---
<BaseLayout lang={lang} title={c.title} description={c.desc} route="partners" breadcrumbs={[{ name: c.title, url: href('partners', lang) }]}>
  <PageHero title={c.h} kicker={c.title} lead={c.lead} tone="ink" />
  <div class="wrap section stack" style="--flow: var(--space-8)">
    {c.cats.map((cat, i) => (
      <section aria-labelledby={`pc-${i}`}>
        <h2 id={`pc-${i}`} class="h3 cat">{cat}</h2>
        <ul class="logos" role="list">
          {i === 0 ? <li class="logo-box">{site.foundation.name}</li> : Array.from({ length: 4 }, () => <li class="logo-box">{c.logos}</li>)}
        </ul>
      </section>
    ))}
    <p class="small">{c.note}</p>
    <section class="why bg-orange stack">
      <h2 data-stretch="130">{c.why}</h2>
      <ul>{c.whyList.map((w) => <li>{w}</li>)}</ul>
      <a class="btn" href={`mailto:${site.emails.office}?subject=${encodeURIComponent(c.subject)}`}>{c.cta}</a>
    </section>
  </div>
</BaseLayout>
<style>
  .cat { text-transform: uppercase; margin-bottom: var(--space-4); }
  .logos { list-style: none; padding: 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); }
  .logo-box { aspect-ratio: 3 / 2; display: grid; place-items: center; text-align: center; border: 3px dashed var(--ofca-ink); background: var(--ofca-white); padding: var(--space-3); font-weight: 700; max-width: none; }
  .why { border: 4px solid var(--ofca-ink); padding: clamp(1.25rem, 4vw, 3rem); }
  .why h2 { font-size: var(--fs-h2); }
  .why ul { padding-left: 1.2em; display: grid; gap: var(--space-2); font-weight: 600; }
</style>

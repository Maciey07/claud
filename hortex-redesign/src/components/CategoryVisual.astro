---
/**
 * Kompozycja kategorii z motywem ruchu (data-motif). Bez JS i przy reduced motion
 * to statyczna kompozycja: packshot + składniki na docelowych pozycjach.
 */
import type { Category, Product } from '../lib/data';
import { img } from '../lib/images';

interface Props { category: Category; product?: Product }
const { category, product } = Astro.props;
const motif = category.motif;
const pieces = [...category.pieces, ...category.pieces].slice(0, motif === 'zupy' ? 6 : 7);

// [left %, top %, width %, rotate]
const LAYOUTS: Record<string, number[][]> = {
  warzywa: [[16, 20, 22, -14], [82, 18, 20, 12], [88, 56, 22, -8], [12, 62, 24, 18], [28, 88, 18, 30], [70, 88, 20, -20], [50, 6, 14, 0]],
  owoce: [[14, 22, 20, -10], [84, 20, 22, 14], [86, 62, 18, -18], [14, 66, 22, 8], [32, 90, 16, 24], [68, 90, 18, -12], [50, 6, 14, 6]],
  zupy: [[42, 40, 16, 0], [56, 46, 15, 40], [46, 58, 16, -30], [60, 60, 13, 80], [36, 52, 13, 120], [52, 34, 12, -60]],
  dania: [[50, 16, 20, 0], [80, 36, 18, 20], [78, 70, 18, -20], [50, 86, 18, 10], [22, 70, 18, 30], [20, 34, 18, -14], [50, 50, 14, 0]],
};
const layout = LAYOUTS[motif] ?? LAYOUTS.warzywa;
---
<div class={`cat-visual cat-visual--${motif}`} data-motif={motif} aria-hidden="true">
  {motif === 'zupy' && (
    <div class="cat-visual__pot" data-pot>
      <span class="cat-visual__handle cat-visual__handle--l"></span>
      <span class="cat-visual__handle cat-visual__handle--r"></span>
      <span class="cat-visual__liquid" data-pot-liquid></span>
    </div>
  )}
  {motif === 'dania' && <div class="cat-visual__plate" data-plate></div>}
  {product && motif !== 'zupy' && motif !== 'dania' && (
    <img class="cat-visual__pack" data-motif-origin src={img.pack(product.slug)} alt="" width="400" height="500" />
  )}
  {product && (motif === 'zupy' || motif === 'dania') && (
    <img class="cat-visual__pack cat-visual__pack--side" src={img.pack(product.slug)} alt="" width="400" height="500" />
  )}
  {pieces.map((k, i) => (
    <img class="cat-visual__piece" data-piece src={img.ing(k)} alt="" width="200" height="200" style={`left:${layout[i][0]}%;top:${layout[i][1]}%;--w:${layout[i][2]}%;rotate:${layout[i][3]}deg`} />
  ))}
</div>

<style>
  .cat-visual { position: relative; aspect-ratio: 1; width: 100%; max-width: 560px; margin-inline: auto; }
  .cat-visual__pack { position: absolute; left: 50%; top: 50%; width: 44%; translate: -50% -50%; z-index: 1; }
  .cat-visual__pack--side { width: 30%; left: 84%; top: 78%; z-index: 3; rotate: 8deg; }
  /* Centrowanie marginesem (nie translate), żeby nie kolidowało z transformacjami GSAP */
  .cat-visual__piece { position: absolute; width: var(--w); margin: calc(var(--w) / -2) 0 0 calc(var(--w) / -2); z-index: 2; filter: drop-shadow(0 10px 12px rgb(60 40 10 / 0.16)); }
  .cat-visual__pot { position: absolute; inset: 14%; border-radius: 50%; background: #3b3f3c; box-shadow: 0 30px 40px -20px rgb(0 0 0 / 0.35); }
  .cat-visual__liquid { position: absolute; inset: 7%; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #f5deaa, #e4b766); }
  .cat-visual__handle { position: absolute; top: 44%; width: 16%; height: 12%; background: #3b3f3c; border-radius: 12px; }
  .cat-visual__handle--l { left: -12%; }
  .cat-visual__handle--r { right: -12%; }
  .cat-visual__plate { position: absolute; inset: 18%; border-radius: 50%; background: radial-gradient(circle, #f4efe5 0 62%, #fbf8f2 63% 100%); box-shadow: 0 30px 40px -24px rgb(60 40 10 / 0.35); }
  .cat-visual__plate::after { content: ''; position: absolute; inset: 20%; border-radius: 50%; border: 2px dashed #e0d6c4; }
  .cat-visual--zupy .cat-visual__piece { z-index: 2; }
</style>

---
interface Props { value: number; suffix?: string; label: string }
const { value, suffix = '', label } = Astro.props;
---
<div class="stat">
  <p class="num" aria-hidden="true"><span data-count-to={value}>{value.toLocaleString('pl-PL')}</span>{suffix}</p>
  <p class="label stat-label" aria-hidden="true">{label}</p>
  <p class="visually-hidden">{value.toLocaleString('pl-PL')}{suffix} {label}</p>
</div>
<style>
  .stat { container-type: inline-size; border-top: 4px solid currentColor; padding-top: var(--space-3); }
  .num {
    font-family: var(--font-display); font-weight: 900; font-size: min(7rem, 22cqi); line-height: 0.85;
    font-variation-settings: 'wdth' 140; letter-spacing: -0.02em; font-variant-numeric: tabular-nums;
  }
  .stat-label { margin-top: var(--space-2); font-size: 1rem; }
</style>

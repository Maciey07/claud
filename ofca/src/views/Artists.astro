---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ArtistPoster from '../components/ArtistPoster.astro';
import { artists } from '../lib/data';
import { href } from '../i18n/routes';
import type { Lang } from '../lib/types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const pl = lang === 'pl';
const c = pl ? {
  title: 'Artyści', h: 'Kto wystąpi', desc: `Artyści Festiwalu OFCA 2026: ${artists.length} zespołów i solistów Nowego Cyrku w Oleśnicy, 14–16 sierpnia 2026.`,
  lead: 'Nowy Cyrk z całego świata na ulicach, pod namiotami i nad Rynkiem. Lista edycji 2026 czeka na potwierdzenie.',
  archive: 'Poprzednie edycje', archiveNote: 'Archiwum artystów z lat 2016–2025: [DO UZUPEŁNIENIA]',
} : {
  title: 'Artists', h: 'Who’s performing', desc: `OFCA 2026 artists: ${artists.length} contemporary circus companies and soloists in Oleśnica, 14–16 August 2026.`,
  lead: 'Contemporary circus from around the world, in the streets, under canvas and above Rynek (Market Square). The 2026 line-up is awaiting confirmation.',
  archive: 'Past editions', archiveNote: 'Artist archive 2016–2025: [DO UZUPEŁNIENIA]',
};
---
<BaseLayout lang={lang} title={c.title} description={c.desc} route="artists" breadcrumbs={[{ name: c.title, url: href('artists', lang) }]}>
  <PageHero title={c.h} kicker={`OFCA 2026 · ${c.title}`} lead={c.lead} tone="orange" />
  <section class="wrap section" aria-label={c.title}>
    <ul class="grid-posters" role="list">
      {artists.map((a, i) => (
        <li><ArtistPoster artist={a} lang={lang} href={href('artist', lang, { slug: a.slug })} index={i} level={2} eager={i < 4} /></li>
      ))}
    </ul>
  </section>
  <section class="wrap archive" aria-labelledby="h-archive">
    <h2 id="h-archive" class="h3">{c.archive}</h2>
    <ul class="chips" aria-label={c.archive}>
      {Array.from({ length: 10 }, (_, i) => 2025 - i).map((y) => <li><span class="chip" aria-disabled="true">{y}</span></li>)}
    </ul>
    <p class="small">{c.archiveNote}</p>
  </section>
</BaseLayout>
<style>
  .grid-posters { list-style: none; padding: 0; display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); }
  .grid-posters li { max-width: none; }
  .archive { padding-bottom: var(--space-9); display: grid; gap: var(--space-4); }
  .archive .chips { list-style: none; padding: 0; }
  .archive .chip { opacity: 0.6; cursor: default; }
</style>

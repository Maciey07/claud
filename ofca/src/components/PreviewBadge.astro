---
/** Przełącznik trybów tylko dla dev/preview (PRD 7.1). */
const modes = ['offseason', 'announce', 'live', 'after'];
---
<aside class="preview" aria-label="Podgląd trybów festiwalu" data-preview>
  <details>
    <summary>Tryb: <strong data-preview-mode>…</strong></summary>
    <div class="menu">
      <p class="small" data-preview-now></p>
      <ul>
        {modes.map((m) => <li><a href={`?mode=${m}`}>{m}</a></li>)}
        <li><a href="?mode=auto">auto (wg dat)</a></li>
      </ul>
    </div>
  </details>
</aside>
<style>
  .preview { position: fixed; right: var(--space-3); bottom: 80px; z-index: 70; font-size: 0.8rem; }
  details { background: var(--ofca-white); border: 2px solid var(--ofca-ink); box-shadow: 4px 4px 0 var(--ofca-ink); }
  summary { cursor: pointer; padding: 6px 10px; list-style: none; font-family: var(--font-display); text-transform: uppercase; }
  .menu { padding: 4px 10px 10px; }
  ul { list-style: none; padding: 0; display: grid; gap: 2px; }
  a { display: block; padding: 4px 0; }
</style>

---
/** Kopuła namiotu w pomarańczowym duotonie (ref-06). flip = odbicie w pionie. */
interface Props { flip?: boolean; class?: string }
const { flip = false, class: cls } = Astro.props;
const stripes = Array.from({ length: 12 }, (_, i) => i);
const uid = `tent-${Math.random().toString(36).slice(2, 8)}`;
---
<svg class:list={['tent-svg', cls]} viewBox="0 0 600 300" aria-hidden="true" focusable="false" style={flip ? 'transform: scaleY(-1)' : undefined}>
  <defs>
    <clipPath id={uid}>
      <path d="M300 18 C 330 120, 470 205, 590 232 L 10 232 C 130 205, 270 120, 300 18 Z" />
    </clipPath>
  </defs>
  <path d="M296 0h8l3 22h-14z" fill="var(--ofca-orange-deep)" />
  <g clip-path={`url(#${uid})`}>
    <rect x="0" y="0" width="600" height="240" fill="var(--ofca-cream)" />
    {stripes.map((i) => i % 2 === 0 && (
      <path d={`M300 18 L ${i * 50} 240 L ${(i + 1) * 50} 240 Z`} fill="var(--ofca-orange)" />
    ))}
    <path d="M300 18 C 330 120, 470 205, 590 232" fill="none" stroke="var(--ofca-orange-deep)" stroke-width="4" />
  </g>
  <rect x="10" y="232" width="580" height="44" fill="var(--ofca-orange)" />
  {Array.from({ length: 12 }, (_, i) => (
    <rect x={10 + i * 48.3} y="232" width="24" height="44" fill="var(--ofca-cream)" opacity="0.9" />
  ))}
  <path d={`M10 276 ${Array.from({ length: 29 }, (_, i) => `L ${10 + (i + 0.5) * 20} 296 L ${10 + (i + 1) * 20} 276`).join(' ')} Z`} fill="var(--ofca-orange-deep)" />
</svg>
<style>
  .tent-svg { width: 100%; height: auto; display: block; }
</style>

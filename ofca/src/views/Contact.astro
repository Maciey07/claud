---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { href } from '../i18n/routes';
import { site } from '../site.config';
import type { Lang } from '../lib/types';
interface Props { lang: Lang }
const { lang } = Astro.props;
const pl = lang === 'pl';
const T = '[DO UZUPEŁNIENIA]';
const c = pl ? {
  title: 'Kontakt', h: 'Napiszcie do nas', desc: 'Kontakt z Festiwalem OFCA i Fundacją OFCA: biuro, media, Sklepik. Materiały prasowe do pobrania.',
  lead: 'Wybierzcie adres według tematu. Odpowiemy tak szybko, jak się da.',
  topics: [
    { h: 'Biuro festiwalu', p: 'Program, współpraca, wolontariat, artyści, dostępność.', e: site.emails.office },
    { h: 'Media', p: 'Akredytacje, wywiady, zdjęcia.', e: site.emails.media },
    { h: 'Sklepik', p: 'Zamówienia, zwroty, reklamacje.', e: site.emails.shop },
  ],
  foundation: 'Dane Fundacji', ids: `NIP, KRS, REGON: ${T}`,
  media: 'Dla mediów', mediaLead: 'Wszystko, czego potrzebujecie do materiału, w jednym miejscu.', kit: 'Pobierz press kit', kitNote: `Logo, zdjęcia i fakty (ZIP): ${T}`,
  facts: 'Fakty w skrócie', factList: ['Festiwal Cyrku Współczesnego OFCA, Oleśnica.', 'Edycja 2026: 14–16 sierpnia 2026, stare miasto.', 'Pierwsza edycja: 2014. Organizator: Fundacja OFCA (od 2015).', 'Dotychczas: 227 artystów z 22 krajów, 150+ wolontariuszy, 6 murali.'],
} : {
  title: 'Contact', h: 'Get in touch', desc: 'Contact the OFCA festival and the OFCA Foundation: office, media, shop. Press kit download.',
  lead: 'Pick the address that fits your question. We’ll reply as soon as we can.',
  topics: [
    { h: 'Festival office', p: 'Programme, partnerships, volunteering, artists, accessibility.', e: site.emails.office },
    { h: 'Media', p: 'Accreditation, interviews, photos.', e: site.emails.media },
    { h: 'Shop', p: 'Orders, returns, complaints.', e: site.emails.shop },
  ],
  foundation: 'Foundation details', ids: `Tax and registry numbers: ${T}`,
  media: 'For media', mediaLead: 'Everything you need for your story, in one place.', kit: 'Download the press kit', kitNote: `Logo, photos and facts (ZIP): ${T}`,
  facts: 'Quick facts', factList: ['OFCA Contemporary Circus Festival, Oleśnica, Poland.', '2026 edition: 14–16 August 2026, old town.', 'First edition: 2014. Organiser: OFCA Foundation (since 2015).', 'So far: 227 artists from 22 countries, 150+ volunteers, 6 murals.'],
};
---
<BaseLayout lang={lang} title={c.title} description={c.desc} route="contact" breadcrumbs={[{ name: c.title, url: href('contact', lang) }]}>
  <PageHero title={c.h} kicker={c.title} lead={c.lead} tone="orange" />
  <div class="wrap section stack" style="--flow: var(--space-8)">
    <ul class="topics" role="list">
      {c.topics.map((tp, i) => (
        <li class:list={['topic', ['bg-lilac', 'bg-white', 'bg-ink on-ink'][i]]}>
          <h2 class="h3">{tp.h}</h2><p>{tp.p}</p><a class="mail" href={`mailto:${tp.e}`}>{tp.e}</a>
        </li>
      ))}
    </ul>
    <section class="cols">
      <div class="stack">
        <h2 class="h3">{c.foundation}</h2>
        <address>{site.foundation.name}<br />{site.foundation.street}<br />{site.foundation.city}</address>
        <p>{c.ids}</p>
      </div>
      <section id={pl ? 'dla-mediow' : 'media'} class="media bg-orange stack" aria-labelledby="h-media">
        <h2 id="h-media" data-stretch="130">{c.media}</h2>
        <p class="lead">{c.mediaLead}</p>
        <p><span class="btn" aria-disabled="true"><Icon name="download" size={20} />{c.kit}</span></p>
        <p class="small">{c.kitNote}</p>
        <h3 class="h3">{c.facts}</h3>
        <ul>{c.factList.map((f) => <li>{f}</li>)}</ul>
        <a href={`mailto:${site.emails.media}`}>{site.emails.media}</a>
      </section>
    </section>
  </div>
</BaseLayout>
<style>
  .topics { list-style: none; padding: 0; display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .topic { border: 3px solid var(--ofca-ink); padding: var(--space-5); display: grid; gap: var(--space-3); align-content: start; max-width: none; }
  .topic h2 { text-transform: uppercase; }
  .mail { font-weight: 800; font-size: 1.15rem; overflow-wrap: anywhere; min-height: 44px; display: inline-flex; align-items: center; }
  .cols { display: grid; gap: var(--space-7); }
  @media (min-width: 900px) { .cols { grid-template-columns: 1fr 1.4fr; align-items: start; } }
  address { font-style: normal; font-weight: 600; font-size: 1.15rem; }
  .media { border: 4px solid var(--ofca-ink); padding: clamp(1.25rem, 4vw, 3rem); }
  .media h2 { font-size: var(--fs-h2); }
  .media ul { padding-left: 1.2em; display: grid; gap: var(--space-2); }
</style>
